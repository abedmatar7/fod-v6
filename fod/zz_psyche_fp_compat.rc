on boot
    chown system system /dev/goodix_fp
    chmod 0660 /dev/goodix_fp
    chown system system /dev/xiaomi-touch
    chmod 0660 /dev/xiaomi-touch

    chown system system /sys/class/drm/card0-DSI-1/disp_param
    chmod 0660 /sys/class/drm/card0-DSI-1/disp_param
    chown system system /sys/class/backlight/panel0-backlight/brightness
    chmod 0664 /sys/class/backlight/panel0-backlight/brightness

    setprop persist.vendor.sys.fp.vendor goodix_fod
    setprop persist.vendor.sys.fp.fod.lhbmoffafterresult 1
